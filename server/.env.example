# ---- Configuration de l'API RouteBénin ----
# Copiez ce fichier en .env puis adaptez si besoin.

# Port d'écoute de l'API
PORT=3001

# Origine autorisée pour CORS (le frontend Vite)
CLIENT_ORIGIN=http://localhost:5173

# Base de données SQLite (fichier local, créé automatiquement)
DATABASE_URL="file:./dev.db"

# --- Services géographiques (OpenStreetMap) ---
# Serveur OSRM (distances routières + itinéraires).
# Par défaut : serveur de démonstration public (usage léger/dev uniquement).
# En production, hébergez votre propre instance (deploy/osrm/README.md), ex. :
#   OSRM_URL=http://localhost:5000
OSRM_URL=https://router.project-osrm.org
# Secours si le principal ne répond pas (« aucun » pour désactiver).
OSRM_URL_SECOURS=https://router.project-osrm.org

# Service de géocodage Nominatim
NOMINATIM_URL=https://nominatim.openstreetmap.org

# User-Agent requis par Nominatim : mettez un contact réel en production.
NOMINATIM_USER_AGENT=RouteBenin/1.0 (contact: exemple@routebenin.bj)

# Pays privilégié pour le géocodage (codes ISO séparés par des virgules)
GEOCODE_COUNTRYCODES=bj

# --- Comptes et entreprises (version multi-clients) ---
# « oui » : connexion obligatoire, chaque entreprise ne voit que ses tournées,
# l'administrateur gère son équipe. « non » : application mono-utilisateur.
# Au passage à « oui », la première entreprise créée récupère l'historique.
COMPTES=non
# Création libre d'un compte entreprise depuis la page de connexion
# (« fermees » : seuls les comptes existants peuvent se connecter).
INSCRIPTIONS=ouvertes
# « oui » derrière un proxy https (cookie de session réservé au https).
COOKIE_SECURISE=non
