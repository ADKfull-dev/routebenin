{
  "name": "routebenin-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API RouteBénin — Express + TypeScript (optimisation, géocodage, persistance).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "bench": "tsx src/bench/benchmark.ts",
    "pack-demo": "tsx src/tools/packDemo.ts",
    "lieux-benin": "tsx src/tools/lieuxBenin.ts",
    "test:watch": "vitest",
    "db:setup": "prisma generate && prisma db push"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "2.8.5",
    "express": "4.21.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.5"
  }
}
