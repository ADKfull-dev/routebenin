// Schéma de base de données RouteBénin.
//
// Choix technique : SQLite via Prisma ORM.
// Le cahier des charges prévoit « SQLite (dev) → PostgreSQL (prod) ». SQLite est
// retenu ici car il ne nécessite aucun serveur à installer/administrer, ce qui
// rend l'application immédiatement fonctionnelle sous Ubuntu pour une démo ou un
// usage mono-poste. Le passage à PostgreSQL ne demande que de changer le
// `provider` et `DATABASE_URL` (les modèles restent identiques).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Une tournée optimisée sauvegardée (historique).
/// Les structures complexes (arrêts, résultat) sont stockées en JSON texte,
/// car SQLite ne possède pas de type JSON natif exploitable par Prisma.
model Tournee {
  id                 String   @id @default(cuid())
  nom                String
  creeLe             DateTime @default(now())

  // Données d'entrée (sérialisées en JSON).
  departJson         String
  arriveeJson        String? // null = retour au départ
  destinationsJson   String

  // Résultat complet (sérialisé en JSON) pour réaffichage à l'identique.
  resultatJson       String

  // Colonnes dénormalisées pour l'affichage rapide des listes/statistiques.
  nombreDestinations Int
  distanceInitiale   Float
  distanceOptimisee  Float
  gainMetres         Float
  gainPourcent       Float
  source             String // "osrm" | "haversine"

  // Mode comptes (COMPTES=oui) : entreprise propriétaire et auteur.
  // null en mode mono-utilisateur (par défaut).
  entrepriseId       String?
  entreprise         Entreprise? @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  auteurId           String?

  @@index([creeLe])
  @@index([entrepriseId, creeLe])
}

/// Mode comptes : une entreprise cliente (ses tournées, ses réglages, son équipe).
model Entreprise {
  id                  String        @id @default(cuid())
  nom                 String
  ville               String?
  prefererOsrm        Boolean       @default(true)
  minutesParLivraison Int           @default(5)
  creeLe              DateTime      @default(now())
  utilisateurs        Utilisateur[]
  tournees            Tournee[]
}

/// Mode comptes : une personne de l'équipe. role = "admin" | "membre".
model Utilisateur {
  id           String     @id @default(cuid())
  email        String     @unique
  nom          String
  /// scrypt : « sel:empreinte » en hexadécimal (jamais le mot de passe).
  motDePasse   String
  role         String     @default("membre")
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  sessions     Session[]
  creeLe       DateTime   @default(now())

  @@index([entrepriseId])
}

/// Session de connexion. id = SHA-256 du jeton du cookie (le jeton n'est pas stocké).
model Session {
  id            String      @id
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  expireLe      DateTime
  creeLe        DateTime    @default(now())

  @@index([utilisateurId])
}

/// Profil unique (mode mono-utilisateur, par défaut). En mode comptes : Entreprise + Utilisateur.
model Profil {
  id            String  @id @default("profil")
  nomUtilisateur String?
  nomEntreprise String?
  ville         String?
  prefererOsrm  Boolean @default(true)
  minutesParLivraison Int @default(5)
}
